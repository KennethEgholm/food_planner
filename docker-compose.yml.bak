services:
  postgres:
    image: postgres:15-alpine
    container_name: food_planner_db
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: password
      POSTGRES_DB: food_planner
    ports:
      - "5432:5432"
    volumes:
        - pgdata:/var/lib/postgresql/data
        - ./server/database.sql:/docker-entrypoint-initdb.d/init.sql

  server:
    build: ./server
    container_name: food_planner_server
    ports:
      - "5001:5001"
    environment:
      - PORT=5001
      - DATABASE_URL=postgresql://user:password@postgres:5432/food_planner
    depends_on:
      - postgres
    volumes:
      - ./server:/app
      - /app/node_modules

  client:
    build: ./client
    container_name: food_planner_client
    ports:
      - "5173:5173"
    environment:
      - VITE_API_URL=http://localhost:5001
    depends_on:
      - server
    volumes:
      - ./client:/app
      - /app/node_modules

volumes:
  pgdata:
